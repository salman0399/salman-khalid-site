---
layout: layouts/base.njk
title: Media
description: Op-eds, television and podcast appearances by Muhammad Salman Khalid.
---
<div class="wrap narrow">
  <header class="page-head">
    <div class="eyebrow">Media</div>
    <h1>Op-eds and appearances</h1>
    <p class="lede">I write and speak about Pakistan's economy, taxation and public policy for a general audience.</p>
  </header>

  <section class="section" style="padding-top:16px">
    <h2>Op-eds</h2>
    <ul class="list">
      {% for m in media.opeds %}
      <li class="item post-row">
        <span class="date">{{ m.date }}</span>
        <div><h3>{% if m.url %}<a href="{{ m.url }}" rel="noopener">{{ m.title }}</a>{% else %}{{ m.title }}{% endif %}</h3><div class="authors">{{ m.outlet }}{% if m.note %} · {{ m.note }}{% endif %}</div></div>
      </li>
      {% endfor %}
    </ul>
  </section>

  <section class="section">
    <h2>Television and podcasts</h2>
    <ul class="list">
      {% for m in media.appearances %}
      <li class="item post-row">
        <span class="date">{{ m.date }}</span>
        <div><h3><a href="{{ m.url }}" rel="noopener">{{ m.title }}</a></h3><div class="authors">{{ m.outlet }}</div>{% if m.note %}<p class="abstract">{{ m.note }}</p>{% endif %}</div>
      </li>
      {% endfor %}
    </ul>
  </section>
</div>
